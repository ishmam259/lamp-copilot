OPENAI_API_KEY=
# Reads invoice and sales-book photos. Switch to gpt-6.1-sol only if accuracy on eval/ is too low.
OPENAI_EXTRACT_MODEL=gpt-6-luna
# Copilot chat and tool calling.
OPENAI_CHAT_MODEL=gpt-6-luna
# Docker Compose publishes its database on host port 5433.
DATABASE_URL=postgresql://lamp:lamp@localhost:5433/lamp
# Tests and the demo use replay (no OpenAI calls). Set to live for real extraction.
LLM_MODE=replay
# Live calls stop once today's OpenAI spend (eval/spend.log) passes this many USD.
LLM_DAILY_BUDGET_USD=1.00
# Secret for the duplicate-financing registry HMAC. Any long random string. Left empty, DEV_MODE=true
# Shared demo (judge link): reset loads the three confirmed captures, and the demo resets itself
# every N minutes (0 = never). Both need DEV_MODE=true.
DEMO_RESET_WITH_CAPTURES=false
DEMO_AUTO_RESET_MINUTES=0
# Crash alerts by email through Brevo (optional). Leave empty for no email. The sender must be a
# verified sender in the Brevo account, and Brevo must have this machine's IP authorised.
BREVO_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# uses a fixed dev key; with DEV_MODE=false the API refuses to start until this is set.
REGISTRY_KEY=
# Demo controls (/dev/reset, the supplier-reply simulator, the Reset button). On here so a fresh
# copy runs the demo; set false (and a REGISTRY_KEY) for anything that isn't a demo machine.
DEV_MODE=true
