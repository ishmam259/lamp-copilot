OPENAI_API_KEY=
# Reads invoice and sales-book photos. Switch to gpt-6.1-sol only if accuracy on eval/ is too low.
OPENAI_EXTRACT_MODEL=gpt-6-luna
# Copilot chat and tool calling.
OPENAI_CHAT_MODEL=gpt-6-luna
DATABASE_URL=postgresql://lamp:lamp@localhost:5432/lamp
# Tests and the demo use replay (no OpenAI calls). Set to live for real extraction.
LLM_MODE=replay
# Secret for the duplicate-financing registry HMAC. Any long random string.
REGISTRY_KEY=change-me
