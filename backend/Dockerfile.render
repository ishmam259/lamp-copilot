# Backend image for Render (render.yaml). Same as backend/Dockerfile, but built from the repo
# root, since Render has no additional build contexts for the seed and the AI recordings.
FROM python:3.12-slim
WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/app ./app
RUN pip install --no-cache-dir .
COPY seed /seed
COPY eval/replay /eval/replay
EXPOSE 8000
# Render sets PORT
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
